{
  "name": "autocode",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build": "python3 scripts/build-local.py",
    "test": "bash scripts/test-local.sh",
    "verify:source": "python3 scripts/verify-build.py --source-only",
    "verify:build": "python3 scripts/verify-build.py --app src-tauri/target/release/bundle/macos/AutoCode.app",
    "test:build-verification": "python3 -m unittest discover -s tests -p 'test_build_verification.py'",
    "test:build-pipeline": "python3 -m unittest discover -s tests -p 'test_build_pipeline.py'",
    "test:ui": "node --test tests/ui-state.test.mjs tests/ui-integration.test.mjs",
    "test:update-manifest": "python3 tests/test_update_manifest.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
